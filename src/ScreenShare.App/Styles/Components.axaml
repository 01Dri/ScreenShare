<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ScreenShare.App.Controls"
                    xmlns:conv="using:Avalonia.Data.Converters">

    <!-- Ação da sala: secundária por padrão, primária com a classe "primary". -->
    <ControlTheme x:Key="{x:Type controls:ActionButton}" TargetType="controls:ActionButton">
        <Setter Property="Background" Value="{DynamicResource FormBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FormBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Path Width="{TemplateBinding IconSize}"
                              Height="{TemplateBinding IconSize}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding $parent[controls:ActionButton].Icon, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                              Stretch="Uniform"
                              Data="{TemplateBinding Icon}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="0 8 20 -10 #26000000" />
        </Style>

        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="^.primary /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #407046C6" />
        </Style>

        <Style Selector="^.primary:pointerover">
            <Setter Property="Background" Value="#7C52D6" />
            <Setter Property="BorderBrush" Value="#7C52D6" />
        </Style>

        <Style Selector="^.primary:pressed">
            <Setter Property="Background" Value="#5B36A8" />
            <Setter Property="BorderBrush" Value="#5B36A8" />
        </Style>

        <Style Selector="^.secondary:pointerover">
            <Setter Property="Background" Value="#1F1A30" />
        </Style>

        <Style Selector="^.secondary:pressed">
            <Setter Property="Background" Value="#141126" />
        </Style>

        <Style Selector="^.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#4A2530" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <Style Selector="^.danger:pointerover">
            <Setter Property="Background" Value="#1F1418" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <Style Selector="^.danger:pressed">
            <Setter Property="Background" Value="#2A171C" />
        </Style>

        <Style Selector="^.danger-solid">
            <Setter Property="Background" Value="#E5484D" />
            <Setter Property="BorderBrush" Value="#E5484D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="^.danger-solid:pointerover">
            <Setter Property="Background" Value="#F25A5E" />
            <Setter Property="BorderBrush" Value="#F25A5E" />
        </Style>

        <Style Selector="^.danger-solid:pressed">
            <Setter Property="Background" Value="#C93A3F" />
            <Setter Property="BorderBrush" Value="#C93A3F" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="#1F1A30" />
            <Setter Property="BorderBrush" Value="{DynamicResource FormBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
