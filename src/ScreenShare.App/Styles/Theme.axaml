<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- Design tokens da tela "Início — compartilhar tela" (Figma: tela).
         Base em preto, com o roxo do design apenas nos destaques. -->

    <LinearGradientBrush x:Key="PageGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#050505" />
        <GradientStop Offset="1" Color="#0A0711" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FormBackgroundBrush" Color="#0A0A0C" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#101014" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2536" />

    <LinearGradientBrush x:Key="StageBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#141019" />
        <GradientStop Offset="1" Color="#0B0A0F" />
    </LinearGradientBrush>

    <!-- Bloom roxo suave no topo da tela cheia. -->
    <RadialGradientBrush x:Key="FormBackgroundGlowBrush"
                         Center="50%,0%"
                         GradientOrigin="50%,0%"
                         RadiusX="1"
                         RadiusY="0.75">
        <GradientStop Offset="0" Color="#331C5E" />
        <GradientStop Offset="0.45" Color="#150F23" />
        <GradientStop Offset="0.8" Color="#0A0A0C" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="FormBorderBrush" Color="#232030" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E0E12" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#1B1230" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7046C6" />

    <SolidColorBrush x:Key="TextBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A1C0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8F89A8" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />

    <!-- O tema Fluent aplica 50% de opacidade ao placeholder; aqui usamos a cor cheia do design. -->
    <sys:Double x:Key="TextControlPlaceholderOpacity">1</sys:Double>

</ResourceDictionary>
