<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenShare.App.ViewModels"
        xmlns:controls="using:ScreenShare.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="812"
        x:Class="ScreenShare.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="tela"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource PageGradientBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Acesso à sala: preenche a janela -->
    <Border Background="{DynamicResource FormBackgroundGlowBrush}"
            BorderThickness="0"
            CornerRadius="0"
            Padding="40,40,40,36">
            <StackPanel Spacing="32">

                <!-- Boas-vindas -->
                <StackPanel Spacing="24">
                    <Border Width="52" Height="52"
                            CornerRadius="16"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource BadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            BoxShadow="0 0 18 0 #337046C6">
                        <Path Width="26" Height="26"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource IconScreenShareBadge}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Border>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Compartilhe sua tela"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   LetterSpacing="-0.8"
                                   LineHeight="36"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Um espaço para ver juntos. Crie uma sala ou entre em uma que já existe."
                                   FontSize="15"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Opacity="0.9"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Cabeçalho: abas iguais com ícone e linha -->
                <Grid>
                    <Border Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource FormBorderBrush}" />
                    <Grid ColumnDefinitions="*,*">
                        <RadioButton Classes="tab"
                                     AutomationProperties.Name="Criar sala"
                                     IsChecked="{Binding IsCreateSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="18" Height="18"
                                      Stretch="None"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconPlus}"
                                      Stroke="{Binding $parent[RadioButton].Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <TextBlock Text="Criar sala" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1"
                                     Classes="tab"
                                     AutomationProperties.Name="Entrar na sala"
                                     IsChecked="{Binding IsJoinSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="18" Height="18"
                                      Stretch="None"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconLogIn}"
                                      Stroke="{Binding $parent[RadioButton].Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <TextBlock Text="Entrar na sala" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Grid>

                <!-- Dados de acesso -->
                <StackPanel Spacing="24">

                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="Seu nome" />
                        <TextBox Classes="field"
                                 Classes.error="{Binding HasUsernameError}"
                                 Text="{Binding Username}"
                                 PlaceholderText="Ex.: Ana Souza"
                                 MaxLength="32">
                            <TextBox.InnerLeftContent>
                                <Path Width="18" Height="18"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Stretch="None"
                                      Data="{StaticResource IconUserRound}"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <TextBlock Classes="error"
                                   Text="{Binding UsernameError}"
                                   IsVisible="{Binding HasUsernameError}" />
                    </StackPanel>

                    <!-- Criar: nome da sala -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsCreating}">
                        <TextBlock Classes="label" Text="Nome da sala" />
                        <TextBox Classes="field"
                                 Classes.error="{Binding HasRoomNameError}"
                                 Text="{Binding RoomName}"
                                 PlaceholderText="Ex.: cafe-com-equipe"
                                 MaxLength="50">
                            <TextBox.InnerLeftContent>
                                <Path Width="18" Height="18"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Stretch="None"
                                      Data="{StaticResource IconHash}"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <TextBlock Classes="error"
                                   Text="{Binding RoomNameError}"
                                   IsVisible="{Binding HasRoomNameError}" />
                        <TextBlock Classes="hint" Text="Escolha um nome fácil de reconhecer." />
                    </StackPanel>

                    <!-- Entrar: ID da sala -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsJoinSelected}">
                        <TextBlock Classes="label" Text="ID da sala" />
                        <TextBox Classes="field"
                                 Text="{Binding RoomId}"
                                 PlaceholderText="Ex.: JNT-482-916"
                                 MaxLength="16">
                            <TextBox.InnerLeftContent>
                                <Path Width="18" Height="18"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Stretch="None"
                                      Data="{StaticResource IconHash}"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <TextBlock Classes="hint" Text="Peça o ID a quem criou a sala." />
                    </StackPanel>

                </StackPanel>

                <!-- Ação do modo atual -->
                <StackPanel Spacing="12">
                    <controls:ActionButton Classes="primary"
                                           Content="Criar sala"
                                           Icon="{StaticResource IconPlus}"
                                           Command="{Binding CreateRoomCommand}"
                                           IsVisible="{Binding IsCreating}" />
                    <controls:ActionButton Classes="primary"
                                           Content="Entrar na sala"
                                           Icon="{StaticResource IconLogIn}"
                                           Command="{Binding JoinRoomCommand}"
                                           IsVisible="{Binding IsJoinSelected}" />
                </StackPanel>

                <!-- Aviso de privacidade -->
                <Border HorizontalAlignment="Center"
                        Padding="16,12"
                        CornerRadius="12"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource FormBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="15" Height="15"
                              VerticalAlignment="Center"
                              Stretch="None"
                              Data="{StaticResource IconShieldCheck}"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <TextBlock Text="Sua tela só é compartilhada quando você permitir."
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Opacity="0.9"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

</Window>
