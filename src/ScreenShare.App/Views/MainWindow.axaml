<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenShare.App.ViewModels"
        xmlns:controls="using:ScreenShare.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="ScreenShare.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ScreenShare"
        Width="480" Height="640"
        MinWidth="420" MinHeight="480"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding Viewport.Height, ElementName=PageScroll}">
            <Border Classes="card"
                    MaxWidth="390"
                    Margin="24"
                    VerticalAlignment="Center">
                <StackPanel>

                    <Border Width="56" Height="56"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentButtonBackground}">
                        <PathIcon Width="26" Height="26"
                                  Foreground="{DynamicResource AccentButtonForeground}"
                                  Data="{StaticResource IconMonitor}" />
                    </Border>

                    <TextBlock Text="ScreenShare"
                               Margin="0,16,0,4"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold" />

                    <TextBlock Text="Crie uma sala ou entre em uma existente."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                    <TextBlock Classes="label" Text="Nome de usuário" />
                    <TextBox Classes="field"
                             Classes.error="{Binding HasUsernameError}"
                             Text="{Binding Username}"
                             PlaceholderText="Como podemos te chamar?"
                             MaxLength="32" />
                    <TextBlock Classes="error"
                               Text="{Binding UsernameError}"
                               IsVisible="{Binding HasUsernameError}" />

                    <TextBlock Classes="label" Text="O que você quer fazer?" />
                    <controls:ChoiceSelector IsFirstSelected="{Binding IsCreatingRoom}"
                                             FirstLabel="Criar sala"
                                             FirstIcon="{StaticResource IconServerPlus}"
                                             FirstHint="Você define o nome e a visibilidade da sala."
                                             SecondLabel="Entrar"
                                             SecondIcon="{StaticResource IconLogin}"
                                             SecondHint="Você entra com o ID de uma sala existente." />

                    <!-- Criar sala -->
                    <StackPanel IsVisible="{Binding IsCreatingRoom}">
                        <TextBlock Classes="label" Text="Nome da sala" />
                        <TextBox Classes="field"
                                 Classes.error="{Binding HasRoomNameError}"
                                 Text="{Binding RoomName}"
                                 PlaceholderText="Ex.: Reunião de equipe"
                                 MaxLength="50" />
                        <TextBlock Classes="error"
                                   Text="{Binding RoomNameError}"
                                   IsVisible="{Binding HasRoomNameError}" />

                        <Grid ColumnDefinitions="Auto,*" Margin="2,14,0,0">
                            <PathIcon Width="14" Height="14"
                                      Margin="0,2,6,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      Data="{StaticResource IconLock}" />
                            <TextBlock Grid.Column="1"
                                       Classes="hint"
                                       Text="Salas privadas: só entra quem tiver o convite." />
                        </Grid>
                    </StackPanel>

                    <!-- Entrar em uma sala -->
                    <StackPanel IsVisible="{Binding IsJoiningRoom}">
                        <TextBlock Classes="label" Text="ID da sala" />
                        <TextBox Classes="field"
                                 Text="{Binding RoomId}"
                                 PlaceholderText="Ex.: A1B2-C3D4"
                                 MaxLength="16" />
                    </StackPanel>

                    <Button Classes="primary accent"
                            Content="Continuar"
                            Command="{Binding ContinueCommand}" />

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</Window>
