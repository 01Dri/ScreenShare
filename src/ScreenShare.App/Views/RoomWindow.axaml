<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenShare.App.ViewModels"
        xmlns:controls="using:ScreenShare.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
        x:Class="ScreenShare.App.Views.RoomWindow"
        x:DataType="vm:RoomViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding RoomName}"
        Width="1080" Height="700"
        MinWidth="760" MinHeight="520"
        CanResize="True"
        Background="{DynamicResource PageGradientBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.stage">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource StageBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.stage.live">
            <Setter Property="BorderBrush" Value="#55E5484D" />
        </Style>
        <Style Selector="Button.copy">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.copy:pointerover">
            <Setter Property="Foreground" Value="#A78BFA" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource FormBackgroundGlowBrush}">
        <Grid Margin="28,24,28,20"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="18">

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding RoomName}"
                               FontSize="24"
                               FontWeight="Bold"
                               LetterSpacing="-0.4"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ParticipantsLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Ellipse Width="3" Height="3"
                                 Fill="{DynamicResource MutedTextBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Sala privada"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">

                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource FormBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CÓDIGO"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.6"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CurrentRoom.JoinKey}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" />
                            <Button Classes="copy"
                                    Content="Copiar"
                                    Click="OnCopyJoinKey"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsLive}"
                            Background="#33E5484D"
                            CornerRadius="999"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7"
                                     Fill="#E5484D"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="AO VIVO"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FF9A9A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Palco -->
            <Border Grid.Row="1"
                    Classes="stage"
                    Classes.live="{Binding IsLive}"
                    ClipToBounds="True">
                <Grid>

                    <!-- Estado da transmissão -->
                    <StackPanel MaxWidth="380"
                                Spacing="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="68" Height="68"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource BadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                BoxShadow="0 0 28 0 #407046C6">
                            <Path Width="34" Height="34"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconScreenShareBadge}"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.3"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding StageTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding StageDescription}"
                                       FontSize="13"
                                       LineHeight="20"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Opacity="0.9"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Participantes como tiles (estilo call) -->
                    <ItemsControl ItemsSource="{Binding Users}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomUserViewModel">
                                <Border Width="150" Height="98"
                                        CornerRadius="12"
                                        Background="#CC0E0E12"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Border Width="40" Height="40"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource BadgeBackgroundBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <Border VerticalAlignment="Bottom"
                                                Background="#99000000"
                                                Padding="8,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Role}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Border>

            <!-- Dock de controles -->
            <StackPanel Grid.Row="2" Spacing="10" HorizontalAlignment="Center">
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ActionButton Classes="primary"
                                               MinWidth="200"
                                               CornerRadius="999"
                                               Content="Iniciar live"
                                               Icon="{StaticResource IconScreenShareBadge}"
                                               Command="{Binding ToggleLiveCommand}"
                                               IsVisible="{Binding !IsLive}" />
                        <controls:ActionButton Classes="danger-solid"
                                               MinWidth="200"
                                               CornerRadius="999"
                                               Content="Encerrar live"
                                               Icon="{StaticResource IconStop}"
                                               Command="{Binding ToggleLiveCommand}"
                                               IsVisible="{Binding IsLive}" />
                        <controls:ActionButton Classes="danger"
                                               CornerRadius="999"
                                               Content="Desligar"
                                               Icon="{StaticResource IconPower}"
                                               Command="{Binding LeaveRoomCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Sua tela só é compartilhada quando você permitir."
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Opacity="0.9"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

        </Grid>
    </Border>

</Window>
